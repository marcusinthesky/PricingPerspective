# Lean 4 (Lake) workspace task runner.
# Run `just lean::<recipe>` from the repo root.

set shell := ["bash", "-uc"]

# Fetch Lean dependencies and update the manifest.
setup:
    cd "$(git -C '{{ justfile_directory() }}' rev-parse --show-toplevel)/src/lean" && lake update

# Fetch mathlib build cache (speeds up the first build).
cache:
    cd "$(git -C '{{ justfile_directory() }}' rev-parse --show-toplevel)/src/lean" && lake exe cache get

# Build all Lean packages (fetches the mathlib cache first).
build: cache
    cd "$(git -C '{{ justfile_directory() }}' rev-parse --show-toplevel)/src/lean" && lake build

# Build = check (Lean has no separate typechecker).
check:
    cd "$(git -C '{{ justfile_directory() }}' rev-parse --show-toplevel)/src/lean" && lake build

# Batteries declaration lint, Mathlib text style, complete indexes and domain boundaries.
lint:
    cd "$(git -C '{{ justfile_directory() }}' rev-parse --show-toplevel)/src/lean" && bash scripts/quality.sh lint

# Apply Mathlib's available text fixes (not a general proof formatter).
fmt:
    cd "$(git -C '{{ justfile_directory() }}' rev-parse --show-toplevel)/src/lean" && bash scripts/quality.sh fmt

# Regenerate package import indexes after adding or deleting modules.
indexes:
    cd "$(git -C '{{ justfile_directory() }}' rev-parse --show-toplevel)/src/lean" && bash scripts/quality.sh indexes-fix

# Strict native syntax/environment lint: currently exposes existing warning debt.
lint-builtin:
    cd "$(git -C '{{ justfile_directory() }}' rev-parse --show-toplevel)/src/lean" && bash scripts/quality.sh builtin

# Native JSON reporting; findings do not make this reporting command fail.
quality-report:
    cd "$(git -C '{{ justfile_directory() }}' rev-parse --show-toplevel)/src/lean" && bash scripts/quality.sh report

# Community import analysis for the current legacy-format modules; advisory output.
imports:
    cd "$(git -C '{{ justfile_directory() }}' rev-parse --show-toplevel)/src/lean" && bash scripts/quality.sh imports

# Native import minimization requires conversion to Lean's module system first.
shake:
    cd "$(git -C '{{ justfile_directory() }}' rev-parse --show-toplevel)/src/lean" && lake shake --keep-public

# Strict rebuild policy, including warnings in dependencies.
warnings:
    cd "$(git -C '{{ justfile_directory() }}' rev-parse --show-toplevel)/src/lean" && lake --wfail build

# Independently replay compiled proofs with the upstream kernel checker.
kernel-check:
    cd "$(git -C '{{ justfile_directory() }}' rev-parse --show-toplevel)/src/lean" && lake check

# Check durable dependency direction through Lake's native module import graph.
boundaries:
    cd "$(git -C '{{ justfile_directory() }}' rev-parse --show-toplevel)/src/lean" && bash scripts/quality.sh boundaries

# Regression checks for build freshness and fail-fast quality orchestration.
quality-test:
    cd "$(git -C '{{ justfile_directory() }}' rev-parse --show-toplevel)/src/lean" && \
      uv run --no-project python -m unittest discover -s tools/quality -v

# Regression-test the compiled sorry/True classifier and the gate's safety contracts.
sorry-test:
    cd "$(git -C '{{ justfile_directory() }}' rev-parse --show-toplevel)/src/lean" && \
      uv run --no-project python -m unittest discover -s tools/sorry-audit/tests -v

# Verify the coordinated public dependency pins and toolchains.
dependency-audit:
    cd "$(git -C '{{ justfile_directory() }}' rev-parse --show-toplevel)/src/lean" && \
      uv run --no-project python -m unittest discover -s tools/mathecon-audit/tests -v && \
      uv run --no-project python tools/mathecon-audit/audit.py

# Remove build artifacts.
clean:
    cd "$(git -C '{{ justfile_directory() }}' rev-parse --show-toplevel)/src/lean" && lake clean

# Repair a Lean toolchain orphaned by a nix GC: re-realize the lean4-nix store path via the flake devShell, then warm the cache and rebuild.
doctor:
    cd "$(git -C '{{ justfile_directory() }}' rev-parse --show-toplevel)" && \
      nix develop ./infra/nix --command bash -c 'cd src/lean && lake exe cache get && lake build'

# Compile native publication nodes and export LeanArchitect's LaTeX and JSON.
architect-export:
    cd "$(git -C '{{ justfile_directory() }}' rev-parse --show-toplevel)/src/lean" && \
      bash scripts/sorry_gate.sh --preflight && \
      lake build Publication:blueprint Publication:blueprintJson \
        PricingPerspective:blueprint PricingPerspective:blueprintJson \
        WassersteinGeometry:blueprint WassersteinGeometry:blueprintJson

# The proof-certification owner for CI, DVC and arXiv source bundles. An optional
# project skips papers without approved claims; claimed papers certify the same
# complete workspace. Prose-only correspondence remains the cheap check below.
certify project="":
    #!/usr/bin/env bash
    set -euo pipefail
    cd "$(git -C '{{ justfile_directory() }}' rev-parse --show-toplevel)/src/lean"
    if [[ -n '{{ project }}' ]]; then
      if uv run --no-project python - '{{ project }}' <<'PYPROJECT'
    import importlib.util, sys
    from pathlib import Path
    spec = importlib.util.spec_from_file_location("claim_renderer", Path("tools/claim-manifest/render.py"))
    renderer = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(renderer)
    sys.exit(0 if sys.argv[1] in renderer.mapping_owners(renderer.discover_mappings()) else 3)
    PYPROJECT
      then
        :
      else
        project_status=$?
        if [[ "$project_status" == 3 ]]; then exit 0; fi
        exit "$project_status"
      fi
    fi
    bash scripts/sorry_gate.sh
    uv run --no-project python tools/import-boundaries/check.py
    lake build Publication:blueprint Publication:blueprintJson \
      PricingPerspective:blueprint PricingPerspective:blueprintJson \
      WassersteinGeometry:blueprint WassersteinGeometry:blueprintJson
    uv run --no-project python tools/claim-manifest/extract.py -v
    uv run --no-project python tools/claim-manifest/render.py
    uv run --no-project python tools/claim-manifest/tests/test_manifest.py

# Compatibility entry point; freshness and integrity are always owned by certify.
claims-render: certify

# Validate the authored/generated Blueprint boundary against the committed
# manifest: unique labels, no hand-authored \lean/\leanok, bindings match the
# manifest projection, and no Lean identifier or Blueprint macro leaked into a
# publication chapter. CHEAP and text-only — no Lake, no network. Mirrored as
# the DVC `lean_bindings_check` verify-only stage, so ordinary prose edits
# re-run this and never the per-claim Lean checks above.

# Validate the authored/generated Blueprint boundary against the manifest (cheap, no Lake).
claims-check:
    cd "$(git -C '{{ justfile_directory() }}' rev-parse --show-toplevel)/src/lean" && \
      uv run --no-project python blueprint/tests/test_blueprint.py && \
      uv run --no-project python blueprint/check.py

# Check the four publication projects against their reviewed disclosures.
claims-publication-check:
    uv run --no-project python blueprint/check.py --project 01_continuous_bounds --project 03_distance_implied_mpt --project 05_spatial_pricing --project 06_information_motion

# Regenerate and validate the claim-manifest projections used by LeanBlueprint.
blueprint-prepare: claims-render claims-check

# Build the pinned upstream declaration checker. This is a SECOND Lake root
# (blueprint/checkdecls/lakefile.lean) that `lake build` at src/lean never
# touches, and its git dependency is fetched on first build — so on a fresh
# worktree `blueprint-check` would otherwise fail at its final step for a
# provisioning reason, not a proof reason. It reuses the parent workspace's
# packagesDir, so it clones no second mathlib (~7M of build output).

# Build the pinned upstream checkdecls helper (second Lake root; needed by blueprint-check).
checkdecls-build:
    cd "$(git -C '{{ justfile_directory() }}' rev-parse --show-toplevel)/src/lean/blueprint/checkdecls" && \
      lake build

# Warm a cold checkout (fresh worktree / post-GC) to the point where every Lean
# gate runs: mathlib cache, workspace build, and the checkdecls helper root.

# Provision a cold checkout: mathlib cache + workspace + checkdecls helper.
warm: build checkdecls-build
    @echo "lean: workspace and checkdecls helper built — blueprint-check is runnable"

# Build the workspace and web extraction, then run upstream checkdecls through
# the monorepo adapter. The web pass produces blueprint/lean_decls.
blueprint-check: checkdecls-build blueprint-prepare
    cd "$(git -C '{{ justfile_directory() }}' rev-parse --show-toplevel)/src/lean" && \
      uv run --no-project python blueprint/check.py --native-dir .lake/build/blueprint && \
      uv run --project blueprint --locked python blueprint/run_leanblueprint.py web && \
      uv run --project blueprint --locked python blueprint/run_leanblueprint.py checkdecls

# Build the printable proof-development companion, separate from the arXiv manuscripts.
blueprint-pdf: blueprint-prepare
    #!/usr/bin/env bash
    set -euo pipefail
    repository_root="$(git -C '{{ justfile_directory() }}' rev-parse --show-toplevel)"
    cd "$repository_root/src/lean/blueprint/src"
    mkdir -p ../print
    tectonic -X compile --untrusted --only-cached \
      --bundle "$repository_root/src/latex/bundle/tlextras-2022.0r0-pricing-perspective.zip" \
      --outdir ../print print.tex

# Build the HTML proof-development companion.
blueprint-web: blueprint-prepare
    cd "$(git -C '{{ justfile_directory() }}' rev-parse --show-toplevel)/src/lean" && \
      uv run --project blueprint --locked python blueprint/run_leanblueprint.py web

# Run validation, declaration checks, and both companion renderers.
blueprint-all: blueprint-check blueprint-pdf

# Complete publication trust and quality gate for the retained proof closure.
publication-check: quality-test sorry-test dependency-audit certify lint claims-check claims-publication-check

#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""Build and audit an anonymous manuscript/electronic-companion source pair.

The disposable combined compile defines label ownership and counter state.
Each standalone imports only the other document's labels. Both are compiled
from the staged source closure, and again from an unpacked archive. Published
PDF bytes are taken from those independent unpacked compiles. The source
archive contains identifying metadata and internal provenance: it is an
INTERNAL reproduction bundle, not an anonymous reviewer upload.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import re
import runpy
import shutil
import sys
import tarfile
import tempfile
from pathlib import Path

import tomllib

TOOLS = Path(__file__).resolve().parent
AUDIT = runpy.run_path(str(TOOLS / "bundle-audit"))
AuditError = AUDIT["AuditError"]
TARGET = "management-science"
COMPANION = "management-science-companion"
FRAGMENTS = Path("targets/management-science")
HANDOFFS = Path("generated")
GENERATED_LABELS = (
    "management_science_external_main.tex",
    "management_science_external_companion.tex",
    "management_science_counters.tex",
)


def digest(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def write_json(path: Path, data: dict) -> None:
    path.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n", encoding="utf-8")


def labels(aux: str) -> tuple[dict[str, str], dict[str, str]]:
    """Preserve compiler-written values verbatim; reject duplicate ownership."""
    before: dict[str, str] = {}
    after: dict[str, str] = {}
    current = before
    boundaries = 0
    for line in aux.splitlines():
        if line.strip() == r"\ppMSBoundary":
            boundaries += 1
            current = after
        match = re.match(r"\\newlabel\{([^{}]+)\}(.*)$", line)
        if match:
            key, value = match.groups()
            if key in before or key in after:
                raise AuditError(f"duplicate compiler label: {key}")
            if not value.startswith("{{"):
                raise AuditError(f"malformed compiler label: {key}")
            current[key] = value
    if boundaries > 1:
        raise AuditError("duplicate catalog boundary")
    return before, after


def first_group(value: str) -> str:
    """The printed number/type group, excluding document-specific page fields."""
    if not value.startswith("{{"):
        raise AuditError("malformed label value")
    depth = 0
    for index, char in enumerate(value[1:], start=1):
        if char == "{":
            depth += 1
        elif char == "}":
            depth -= 1
            if depth == 0:
                return value[2:index]
    raise AuditError("unbalanced label value")


def compare_catalog(actual: dict[str, str], expected: dict[str, str]) -> None:
    if actual.keys() != expected.keys():
        raise AuditError(
            f"unmatched compiler labels: missing={sorted(expected.keys() - actual.keys())}; "
            f"unexpected={sorted(actual.keys() - expected.keys())}"
        )
    stale = [
        key for key in actual if first_group(actual[key]) != first_group(expected[key])
    ]
    if stale:
        raise AuditError("stale label numbering/types: " + ", ".join(stale))


def audit_entrypoints(stage: Path) -> None:
    """Reject divergent compile aliases even for interactive/unmapped builds."""
    for alias, canonical in (
        ("main.tex", Path("targets") / f"{TARGET}.tex"),
        ("companion.tex", Path("targets") / f"{COMPANION}.tex"),
        ("catalog.tex", FRAGMENTS / "combined.tex"),
    ):
        if (stage / alias).read_bytes() != (stage / canonical).read_bytes():
            raise AuditError(f"entrypoint differs from canonical adapter: {alias}")


def compile_document(
    stage: Path, main: str, bundle: str, check_log: bool = True
) -> Path:
    audit_entrypoints(stage)
    rules = stage / f"{Path(main).stem}.mk"
    AUDIT["run"](
        [
            "tectonic",
            "-X",
            "compile",
            # Random clean-room paths and wall-clock dates must not alter tracked PDFs.
            "-Z",
            "deterministic-mode",
            "--untrusted",
            "--only-cached",
            "--keep-logs",
            "--keep-intermediates",
            "--bundle",
            bundle,
            "--makefile-rules",
            str(rules),
            "--outdir",
            str(stage),
            main,
        ],
        stage,
    )
    AUDIT["audit_rules_closure"](rules, stage)
    if check_log:
        AUDIT["audit_check_log"](stage, Path(main).stem)
    return rules


def source_manifest(stage: Path) -> dict[str, str]:
    excluded = {
        "label-catalog.json",
        "ms-counter-state.tex",
        "MANIFEST.json",
        "main.pdf",
        "companion.pdf",
        "catalog.pdf",
    }
    return {
        path.relative_to(stage).as_posix(): digest(path)
        for path in AUDIT["source_files"](stage)
        if path.name not in excluded
        and path.relative_to(stage).as_posix()
        not in {(HANDOFFS / name).as_posix() for name in GENERATED_LABELS}
    }


def external_text(external: dict[str, str]) -> str:
    return (
        "% Compiler-derived external labels; never edit.\n"
        + "\n".join(
            r"\newlabel{" + key + "}" + value for key, value in sorted(external.items())
        )
        + "\n"
    )


def prepare_labels(stage: Path, bundle: str) -> dict:
    audit_entrypoints(stage)
    # Generated handoffs are deliberately absent while building the catalog.
    for name in GENERATED_LABELS:
        (stage / HANDOFFS / name).unlink(missing_ok=True)
    compile_document(stage, "catalog.tex", bundle)
    aux = (stage / "catalog.aux").read_text(encoding="utf-8")
    if aux.splitlines().count(r"\ppMSBoundary") != 1:
        raise AuditError("catalog must contain exactly one compiler handoff")
    main, companion = labels(aux)
    if not main or not companion:
        raise AuditError("both documents must own compiler labels")
    for name, external in (
        ("management_science_external_main.tex", companion),
        ("management_science_external_companion.tex", main),
    ):
        (stage / HANDOFFS / name).write_text(
            external_text(external),
            encoding="utf-8",
        )
    counters = stage / "ms-counter-state.tex"
    if not counters.is_file() or not counters.read_text().startswith(r"\setcounter"):
        raise AuditError("missing compiler counter handoff")
    shutil.copyfile(counters, stage / HANDOFFS / "management_science_counters.tex")
    catalog = {
        "schema_version": "1.0",
        "sources": source_manifest(stage),
        "main": main,
        "companion": companion,
        "counters_sha256": digest(stage / HANDOFFS / "management_science_counters.tex"),
    }
    write_json(stage / "label-catalog.json", catalog)
    return catalog


def verify_labels(stage: Path, catalog: dict) -> None:
    if source_manifest(stage) != catalog["sources"]:
        raise AuditError("stale label catalog: source closure changed")
    for name, field in (
        ("management_science_external_main.tex", "companion"),
        ("management_science_external_companion.tex", "main"),
    ):
        if (stage / HANDOFFS / name).read_text(encoding="utf-8") != external_text(
            catalog[field]
        ):
            raise AuditError("stale external label import: " + name)
    if (
        digest(stage / HANDOFFS / "management_science_counters.tex")
        != catalog["counters_sha256"]
    ):
        raise AuditError("stale counter handoff")
    for stem, field in (("main", "main"), ("companion", "companion")):
        local, unexpected = labels((stage / f"{stem}.aux").read_text(encoding="utf-8"))
        if unexpected:
            raise AuditError("standalone document contains catalog boundary")
        compare_catalog(local, catalog[field])


def audit_anonymity(pdf: Path, metadata: Path) -> None:
    """Gate identifying front matter and PDF metadata, preserving attributed cites."""
    raw = metadata.read_text(encoding="utf-8")
    personal = []
    for key in (
        "paperauthorone",
        "paperauthortwo",
        "paperaffiliations",
        "paperemail",
        "paperphone",
    ):
        match = re.search(r"\\newcommand\{\\" + key + r"\}\{([^{}]+)\}", raw)
        if match:
            personal.append(" ".join(match.group(1).split()))
    info = AUDIT["run"](["pdfinfo", str(pdf)], pdf.parent).stdout.decode(
        "utf-8", errors="replace"
    )
    author = re.search(r"^Author:\s*(.*)$", info, re.MULTILINE)
    if author and author.group(1).strip():
        raise AuditError("anonymous PDF contains Author metadata")
    front = AUDIT["run"](["pdftotext", "-f", "1", "-l", "1", str(pdf), "-"], pdf.parent)
    normalized = " ".join(front.stdout.decode("utf-8", errors="replace").split())
    for value in personal:
        if (
            value.casefold() in normalized.casefold()
            or value.casefold() in info.casefold()
        ):
            raise AuditError(f"anonymous PDF exposes personal front matter: {value}")
    if re.search(r"[\w.+-]+@[\w.-]+\.[A-Za-z]{2,}", normalized):
        raise AuditError("anonymous front matter contains an email address")


def stage_sources(project: Path, stage: Path) -> None:
    source = project / "src"
    stage.mkdir(parents=True, exist_ok=True)
    for name in (
        "metadata.tex",
        "body.tex",
        "appendix.tex",
        "pp-manuscript.sty",
        "refs.bib",
    ):
        shutil.copyfile(source / name, stage / name)
    for directory in ("chapters", "generated"):
        shutil.copytree(source / directory, stage / directory)
    (stage / "targets").mkdir()
    shutil.copytree(source / FRAGMENTS, stage / FRAGMENTS)
    for name, destination in ((TARGET, "main.tex"), (COMPANION, "companion.tex")):
        shutil.copyfile(source / "targets" / f"{name}.tex", stage / destination)
        shutil.copyfile(
            source / "targets" / f"{name}.tex", stage / "targets" / f"{name}.tex"
        )
    shutil.copyfile(source / FRAGMENTS / "combined.tex", stage / "catalog.tex")
    if project.name == "06_information_motion":
        AUDIT["prune_paper6_generated"](stage, "catalog.tex")
    AUDIT["run"](
        [
            sys.executable,
            str(TOOLS / "stage-images"),
            str(source.resolve()),
            str(stage.resolve()),
            "catalog.tex",
        ],
        source,
    )
    identification = (
        "metadata.tex identifies"
        if project.name == "06_information_motion"
        else "metadata.tex and Lean provenance identify"
    )
    (stage / "REPRODUCTION-NOTICE.txt").write_text(
        f"INTERNAL reproduction sources: {identification} authors.\n"
        "Only main.pdf and companion.pdf are anonymous reviewer-facing artifacts.\n"
        "Build via the repository's management-science helper with the pinned TeX bundle.\n",
        encoding="utf-8",
    )


def paired_compile(stage: Path, bundle: str) -> dict:
    catalog = json.loads((stage / "label-catalog.json").read_text(encoding="utf-8"))
    rules = []
    for main in ("main.tex", "companion.tex"):
        rules.append(compile_document(stage, main, bundle))
        AUDIT["audit_class_and_bibstyle"](stage, stage / main, TARGET)
        audit_anonymity(stage / f"{Path(main).stem}.pdf", stage / "metadata.tex")
    verify_labels(stage, catalog)
    # Both standalone closures together must consume every staged image.
    union = stage / "pair.mk"
    union.write_text("\n".join(path.read_text() for path in rules), encoding="utf-8")
    AUDIT["audit_image_closure"](union, stage)
    return catalog


def clean_intermediates(stage: Path) -> None:
    for path in list(stage.iterdir()):
        if path.is_file() and (
            path.suffix in AUDIT["EXCLUDED_SUFFIXES"] | {".toc", ".idx"}
            or path.name
            in {"main.pdf", "companion.pdf", "catalog.pdf", "ms-counter-state.tex"}
        ):
            path.unlink()


def publish_artifacts(payloads: dict[Path, bytes]) -> None:
    """Write the verified PDFs, archive and logs; DVC owns a failed run's outputs."""
    for path, content in payloads.items():
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_bytes(content)


def build(project: Path, bundle: str, release: bool) -> None:
    destination = project / "build" / TARGET
    destination.mkdir(parents=True, exist_ok=True)
    payloads: dict[Path, bytes] = {}
    with tempfile.TemporaryDirectory(
        prefix=".management-science-", dir=destination
    ) as temporary:
        temporary = Path(temporary)
        stage = temporary / "sources"
        stage_sources(project, stage)
        prepare_labels(stage, bundle)
        if (
            release
            and project.name != "06_information_motion"
            and AUDIT["stage_lean_provenance"](TOOLS.parents[2], stage, project.name)
        ):
            catalog = json.loads((stage / "label-catalog.json").read_text())
            catalog["sources"] = source_manifest(stage)
            write_json(stage / "label-catalog.json", catalog)
        paired_compile(stage, bundle)
        verification = AUDIT["lean_provenance"](stage, TARGET) if release else None
        # Validate the companion adapter against the same fresh authored closure.
        if release and verification is not None:
            companion_stage = temporary / "companion-provenance"
            shutil.copytree(stage, companion_stage)
            shutil.copyfile(
                companion_stage / "companion.tex", companion_stage / "main.tex"
            )
            AUDIT["lean_provenance"](companion_stage, COMPANION)
        clean_intermediates(stage)
        files = AUDIT["source_files"](stage)
        AUDIT["audit_shell_escape"](files)
        AUDIT["audit_portable_names"](stage, files)
        AUDIT["audit_includegraphics"](stage, files)
        manifest = (
            AUDIT["build_manifest"](
                stage, files, TARGET, "xetex (Tectonic, anonymous article pair)", bundle
            )
            if release
            else {
                "target": TARGET,
                "files": source_manifest(stage),
                "interactive_only": True,
            }
        )
        manifest["reviewer_facing"] = ["main.pdf", "companion.pdf"]
        manifest["source_archive_anonymous"] = False
        manifest_path = AUDIT["write_manifest"](stage, manifest)
        candidate_archive = temporary / f"{TARGET}.tar.gz"
        AUDIT["archive_deterministically"](
            stage, files, manifest_path, candidate_archive
        )
        unpacked = temporary / "unpacked"
        unpacked.mkdir()
        with tarfile.open(candidate_archive, "r:gz") as archive:
            archive.extractall(unpacked, filter="data")
        # Independently regenerated catalog must exactly equal the archived catalog.
        archived_catalog = (unpacked / "label-catalog.json").read_bytes()
        prepare_labels(unpacked, bundle)
        if (unpacked / "label-catalog.json").read_bytes() != archived_catalog:
            raise AuditError(
                "unpacked source produced a stale or different label catalog"
            )
        paired_compile(unpacked, bundle)
        for stem, name in (("main", TARGET), ("companion", COMPANION)):
            pdf = unpacked / f"{stem}.pdf"
            payloads[destination / f"{name}.pdf"] = pdf.read_bytes()
        companion_output = project / "build" / COMPANION
        payloads[companion_output / f"{COMPANION}.pdf"] = payloads[
            destination / f"{COMPANION}.pdf"
        ]
        if release:
            payloads[destination / candidate_archive.name] = (
                candidate_archive.read_bytes()
            )
        # Keep logs/catalog for human validation without contaminating source archives.
        for name in ("main.log", "companion.log", "catalog.log", "label-catalog.json"):
            payloads[destination / name] = (unpacked / name).read_bytes()
    # Temporary source-tree cleanup completes before any advertised artifact changes.
    publish_artifacts(payloads)
    print(f"management-science: PASS: {destination}")


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=("build", "bundle"))
    parser.add_argument("project", type=Path)
    args = parser.parse_args(argv[1:])
    project = args.project.resolve()
    try:
        config = tomllib.loads((project / "Tectonic.toml").read_text())
        bundle = str((project / config["doc"]["bundle"]).resolve())
        build(project, bundle, args.action == "bundle")
    except (AuditError, OSError, ValueError, KeyError) as exc:
        print(f"management-science: FAIL: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))

set shell := ["bash", "-uc"]

fmt:
    find . -name '*.nix' -type f -exec nixfmt {} +
    nixfmt ../../devenv.nix

fmt-check:
    find . -name '*.nix' -type f -exec nixfmt --check {} +
    nixfmt --check ../../devenv.nix

lint:
    statix check .
    deadnix --fail .

# Evaluate the same package inventory consumed by devenv.
inventory:
    nix eval --json path:.#toolInventory.$(nix eval --impure --raw --expr builtins.currentSystem)

tools:
    just inventory | jq -r '["| Group | Provides | Tools |", "|---|---|---|"] + [.[] | "| **\(.name)** | \(.description) | \(.tools | join(", ")) |"] | .[]'

parity:
    bash check-devenv-parity.sh

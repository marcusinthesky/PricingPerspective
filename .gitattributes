* text=auto eol=lf
uv.lock linguist-generated
dvc.lock linguist-generated
flake.lock linguist-generated
devenv.lock linguist-generated
.semflow/hashes/** linguist-generated
src/latex/projects/*/src/refs.bib linguist-generated

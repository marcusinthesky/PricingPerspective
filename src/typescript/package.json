{
  "name": "@pricing-perspective/typescript-workspace",
  "private": true,
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "verify": "turbo run verify",
    "ci": "turbo run typecheck lint verify:export audit:links audit:schema build-storybook lighthouse:ci",
    "verify:full": "turbo run verify:full"
  },
  "devDependencies": {
    "turbo": "2.10.1"
  }
}

use flake ./infra/nix

# nix-direnv keys its cache on flake.nix/flake.lock only. The dev shell is
# assembled from files those two merely *import*, so editing a group (adding a
# tool, reordering PATH precedence) leaves the cached profile untouched: the
# shell keeps serving the old closure and `command -v <new-tool>` finds nothing
# with no error to explain it. Watch the assembly explicitly so a tool change
# reloads on the next prompt.
watch_file infra/nix/shells/default.nix
watch_file infra/nix/shells/env.nix
for _group in infra/nix/shells/groups/*.nix; do
  watch_file "$_group"
done
unset _group

# CPU-only by default: skip JAX CUDA plugin discovery (avoids a noisy cuInit
# failure traceback on every JAX stage and trims startup). Export a different
# JAX_PLATFORMS before entering the shell if a GPU is available.
export JAX_PLATFORMS=cpu

# Install prek git hooks (idempotent — safe to run on every shell entry).
prek install

# Deliberately absent, relative to the source repository's .envrc:
#
#   * the dotenvx vault decryption — this snapshot ships no encrypted .env and
#     needs no secrets: `dvc pull` reads the public bucket anonymously;
#   * the agentsync link step — it targets `.agents/`, which is not part of the
#     published projection;
#   * the shared-DVC-cache block — it writes `.dvc/config.local`, which here is
#     the operator's own writable remote, and this checkout is not a worktree of
#     a larger cache anyway.

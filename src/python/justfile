set shell := ["bash", "-uc"]

mod pipeline 'apps/pipeline/justfile'
mod hotelling 'apps/hotelling/justfile'
mod dotell 'packages/dotell/justfile'

setup:
    uv sync --locked --all-packages

lint:
    uv run --locked ruff check apps/pipeline apps/hotelling packages/dotell

fmt-check:
    uv run --locked ruff format --check apps/pipeline apps/hotelling packages/dotell

fmt:
    uv run --locked ruff format apps/pipeline apps/hotelling packages/dotell

typecheck:
    uv run --locked pyrefly check apps/pipeline/src apps/pipeline/tests apps/hotelling/src apps/hotelling/tests packages/dotell/src packages/dotell/tests

tach:
    uv run --locked tach check
    uv run --locked tach check-external --exclude packages/dotell

deptry:
    cd apps/pipeline && uv run --locked deptry .
    cd apps/hotelling && uv run --locked deptry .
    cd packages/dotell && uv run --locked deptry .

# Separate pytest processes preserve each package's precision and fixture policy.
test: test-fresh

test-fresh: pipeline::test-fresh hotelling::test-fresh dotell::test-fresh

test-ci: test-fresh

test-all: pipeline::test-all hotelling::test-all dotell::test-all

eval "$(devenv direnvrc)"
use devenv

watch_file devenv.nix
watch_file devenv.yaml
watch_file devenv.lock
watch_file infra/nix/flake.nix
watch_file infra/nix/flake.lock
watch_file src/python/uv.lock
for definition in infra/nix/shells/*.nix infra/nix/pkgs/*.nix; do
  watch_file "$definition"
done
unset definition

import PricingPerspective.Operating.RationalShare

set_option linter.style.longLine false

/-!
# Exact response to a frozen rival field

This module isolates one firm's optimisation problem in the rational-share economy.  The rival
appeal at every demand node is frozen at a strictly positive field `B`; the firm chooses a
nonnegative activity block and may face a Euclidean proximal penalty around an incumbent block.

The response is defined as an actual payoff maximiser.  `isExactResponse_iff_solvesVI` proves that
this optimisation problem is exactly the variational inequality for the displayed negative
gradient.  Existence and uniqueness then follow on the uncapped orthant from demand monotonicity,
own-cost curvature, and the global Lipschitz bound.  In particular, the proof does not treat the
proximal centre as a nonnegative linear cost: after completing the square its affine coefficient
is signed.
-/

namespace PricingPerspective.Operating.RationalShare.FirmResponse.Response

open PricingPerspective.Operating.VariationalInequality

open Finset
open scoped RealInnerProductSpace

variable {κ α ι : Type*} [Fintype κ] [Fintype α]

/-- A single firm's activity block, represented as a one-firm rational-share profile. -/
abbrev Block (α : Type*) [Fintype α] := Profile Unit α

/-- The uncapped nonnegative orthant for a firm's activity block. -/
def orthant : Set (Block α) := {q | ∀ p, 0 ≤ q p}

/-- Coordinatewise characterization of block-orthant membership. -/
theorem mem_orthant {q : Block α} : q ∈ orthant ↔ ∀ p, 0 ≤ q p := Iff.rfl

/-- The block orthant is convex. -/
theorem convex_orthant : Convex ℝ (orthant : Set (Block α)) := by
  intro x hx y hy a b ha hb _ p
  simpa using add_nonneg (mul_nonneg ha (hx p)) (mul_nonneg hb (hy p))

/-- The block orthant is closed. -/
theorem isClosed_orthant : IsClosed (orthant : Set (Block α)) := by
  have heq : (orthant : Set (Block α)) = ⋂ p, {q : Block α | 0 ≤ q p} := by
    ext q
    simp [orthant]
  rw [heq]
  exact isClosed_iInter fun p ↦ isClosed_le continuous_const (EuclideanSpace.proj p).continuous

/-- The block orthant is complete in the inherited Euclidean metric. -/
theorem isComplete_orthant : IsComplete (orthant : Set (Block α)) :=
  isClosed_orthant.isComplete

/-- The zero activity block witnesses nonemptiness of the orthant. -/
theorem orthant_nonempty : (orthant : Set (Block α)).Nonempty :=
  ⟨0, fun _ ↦ le_refl 0⟩

/-- Read a one-firm block as an activity-indexed function. -/
def activity (q : Block α) : α → ℝ := fun a ↦ q ((), a)

/-- Embed an activity-indexed function as a one-firm block. -/
def ofActivity (q : α → ℝ) : Block α := WithLp.toLp 2 fun p ↦ q p.2

/-- Reading an embedded activity function returns that function coordinatewise. -/
@[simp] theorem activity_ofActivity (q : α → ℝ) (a : α) : activity (ofActivity q) a = q a :=
  rfl

/-- Embedding all coordinates of a block returns the original one-firm block. -/
@[simp] theorem ofActivity_activity (q : Block α) : ofActivity (activity q) = q := by
  ext p
  rcases p with ⟨i, a⟩
  cases i
  rfl

/-- Freeze the outside option of `N` at the rival-appeal field `B`. -/
def frozenNodes (N : Nodes κ α) (B : κ → ℝ) (hB : ∀ l, 0 < B l) : Nodes κ α where
  revenue := N.revenue
  kernel := N.kernel
  outside := B
  revenue_nonneg := N.revenue_nonneg
  kernel_nonneg := N.kernel_nonneg
  outside_pos := hB

/-- Freezing rivals preserves every node's revenue. -/
@[simp] theorem frozenNodes_revenue (N : Nodes κ α) (B : κ → ℝ)
    (hB : ∀ l, 0 < B l) (l : κ) : (frozenNodes N B hB).revenue l = N.revenue l := rfl

/-- Freezing rivals preserves the activity-to-appeal kernel. -/
@[simp] theorem frozenNodes_kernel (N : Nodes κ α) (B : κ → ℝ)
    (hB : ∀ l, 0 < B l) (l : κ) (a : α) :
    (frozenNodes N B hB).kernel l a = N.kernel l a := rfl

/-- Freezing rivals preserves the appeal generated by a standalone block. -/
@[simp] theorem frozenNodes_blockAppeal (N : Nodes κ α) (B : κ → ℝ)
    (hB : ∀ l, 0 < B l) (q : α → ℝ) (l : κ) :
    (frozenNodes N B hB).blockAppeal q l = N.blockAppeal q l := rfl

/-- The unique firm's frozen-game appeal is its block appeal in the original nodes. -/
@[simp] theorem frozenNodes_appeal (N : Nodes κ α) (B : κ → ℝ)
    (hB : ∀ l, 0 < B l) (q : Block α) (l : κ) :
    (frozenNodes N B hB).appeal q () l = N.blockAppeal (activity q) l := rfl

/-- The frozen-game denominator is rival appeal plus the focal firm's block appeal. -/
@[simp] theorem frozenNodes_denom (N : Nodes κ α) (B : κ → ℝ)
    (hB : ∀ l, 0 < B l) (q : Block α) (l : κ) :
    (frozenNodes N B hB).denom q l = B l + N.blockAppeal (activity q) l := by
  rw [Nodes.denom]
  change B l + ∑ i : Unit, (frozenNodes N B hB).appeal q i l = _
  rw [Fintype.sum_unique, frozenNodes_appeal]

/-- In the one-firm frozen game, the entire rival contribution is the frozen field `B`. -/
@[simp] theorem frozenNodes_rival (N : Nodes κ α) (B : κ → ℝ)
    (hB : ∀ l, 0 < B l) (q : Block α) (l : κ) :
    (frozenNodes N B hB).rival q () l = B l := by
  rw [Nodes.rival, frozenNodes_denom, frozenNodes_appeal]
  ring

/-- Completing the proximal square shifts the affine cost by `-kappa * z0`. -/
def effectiveCost (c : α → ℝ) (kappa : ℝ) (z0 : Block α) (_i : Unit) (a : α) : ℝ :=
  c a - kappa * z0 ((), a)

variable [DecidableEq α]

/-- Completing the proximal square adds `kappa` to the own-cost diagonal. -/
def effectiveCurvature (H : α → α → ℝ) (kappa : ℝ) (_i : Unit) (a b : α) : ℝ :=
  H a b + kappa * if a = b then 1 else 0

omit [Fintype α] in
/-- The proximal diagonal preserves symmetry of the own-cost quadratic. -/
theorem effectiveCurvature_symm {H : α → α → ℝ} (hH : ∀ a b, H a b = H b a)
    (kappa : ℝ) (i : Unit) (a b : α) :
    effectiveCurvature H kappa i a b = effectiveCurvature H kappa i b a := by
  simp only [effectiveCurvature, hH a b]
  by_cases h : a = b
  · subst h
    rfl
  · rw [if_neg h, if_neg (Ne.symm h)]

/-- The proximal diagonal adds exactly `kappa` times the squared Euclidean norm to the
own-cost quadratic form. -/
theorem effectiveCurvature_quadratic (H : α → α → ℝ) (kappa : ℝ) (i : Unit)
    (u : α → ℝ) :
    (∑ a, ∑ b, effectiveCurvature H kappa i a b * u a * u b)
      = (∑ a, ∑ b, H a b * u a * u b) + kappa * ∑ a, u a ^ 2 := by
  have hrow : ∀ a, (∑ b, effectiveCurvature H kappa i a b * u a * u b)
      = (∑ b, H a b * u a * u b) + kappa * u a ^ 2 := by
    intro a
    have hexpand : ∀ b, effectiveCurvature H kappa i a b * u a * u b
        = H a b * u a * u b + kappa * (if a = b then u a * u b else 0) := by
      intro b
      simp only [effectiveCurvature]
      by_cases h : a = b
      · rw [if_pos h, if_pos h]
        ring
      · rw [if_neg h, if_neg h]
        ring
    rw [Finset.sum_congr rfl fun b _ ↦ hexpand b, Finset.sum_add_distrib,
      ← Finset.mul_sum, Finset.sum_ite_eq (Finset.univ : Finset α) a fun b ↦ u a * u b]
    simp only [Finset.mem_univ, if_true]
    ring
  rw [Finset.sum_congr rfl fun a _ ↦ hrow a, Finset.sum_add_distrib, ← Finset.mul_sum]

/-- Positive proximal weight adds to the inherited curvature modulus. -/
theorem effectiveCurvature_bound {H : α → α → ℝ} {mu kappa : ℝ}
    (hH : ∀ u : α → ℝ,
      mu * ∑ a, u a ^ 2 ≤ ∑ a, ∑ b, H a b * u a * u b)
    (i : Unit) (u : α → ℝ) :
    (mu + kappa) * ∑ a, u a ^ 2
      ≤ ∑ a, ∑ b, effectiveCurvature H kappa i a b * u a * u b := by
  rw [effectiveCurvature_quadratic]
  have := hH u
  linarith

/-- Payoff of a focal firm against frozen rival appeal `B`, including an optional proximal
penalty of weight `kappa` around `z0`. -/
noncomputable def blockPayoff (N : Nodes κ α) (B : κ → ℝ) (c : α → ℝ)
    (H : α → α → ℝ) (kappa : ℝ) (z0 q : Block α) : ℝ :=
  (∑ l, N.revenue l * N.blockAppeal (activity q) l /
      (B l + N.blockAppeal (activity q) l))
    - ∑ a, c a * q ((), a)
    - (1 / 2) * ∑ a, ∑ b, H a b * q ((), a) * q ((), b)
    - (kappa / 2) * ∑ a, (q ((), a) - z0 ((), a)) ^ 2

omit [DecidableEq α] in
private theorem effectiveCost_sum (c : α → ℝ) (kappa : ℝ) (z0 q : Block α) :
    (∑ a, effectiveCost c kappa z0 () a * q ((), a))
      = (∑ a, c a * q ((), a)) - kappa * ∑ a, z0 ((), a) * q ((), a) := by
  calc
    (∑ a, effectiveCost c kappa z0 () a * q ((), a))
        = ∑ a, (c a * q ((), a) - kappa * (z0 ((), a) * q ((), a))) :=
          Finset.sum_congr rfl fun a _ ↦ by rw [effectiveCost]; ring
    _ = (∑ a, c a * q ((), a)) - ∑ a, kappa * (z0 ((), a) * q ((), a)) := by
          rw [Finset.sum_sub_distrib]
    _ = _ := by rw [← Finset.mul_sum]

omit [DecidableEq α] in
private theorem sq_sub_sum (q z0 : Block α) :
    (∑ a, (q ((), a) - z0 ((), a)) ^ 2)
      = (∑ a, q ((), a) ^ 2) - 2 * (∑ a, z0 ((), a) * q ((), a))
        + ∑ a, z0 ((), a) ^ 2 := by
  calc
    (∑ a, (q ((), a) - z0 ((), a)) ^ 2)
        = ∑ a, (q ((), a) ^ 2 - 2 * (z0 ((), a) * q ((), a))
            + z0 ((), a) ^ 2) := Finset.sum_congr rfl fun a _ ↦ by ring
    _ = _ := by
      rw [Finset.sum_add_distrib, Finset.sum_sub_distrib, ← Finset.mul_sum]

/-- Completing the proximal square turns the focal objective into the existing one-firm
rational-share payoff, up to a constant independent of the chosen block. -/
theorem blockPayoff_eq_payoff_sub_centerConst (N : Nodes κ α) (B : κ → ℝ)
    (hB : ∀ l, 0 < B l) (c : α → ℝ) (H : α → α → ℝ) (kappa : ℝ)
    (z0 q : Block α) :
    blockPayoff N B c H kappa z0 q
      = payoff (frozenNodes N B hB) (effectiveCost c kappa z0)
          (effectiveCurvature H kappa) () q
        - (kappa / 2) * ∑ a, z0 ((), a) ^ 2 := by
  have hquad := effectiveCurvature_quadratic H kappa () (activity q)
  simp only [activity] at hquad
  rw [blockPayoff, payoff]
  simp only [frozenNodes_revenue, frozenNodes_appeal, frozenNodes_denom]
  rw [effectiveCost_sum, hquad, sq_sub_sum]
  ring

omit [DecidableEq α] in
/-- In a one-firm profile, replacing the unique firm by an activity function is exactly
`ofActivity`. -/
@[simp] theorem replaceFirm_singleton (q : Block α) (r : α → ℝ) :
    replaceFirm q () r = ofActivity r := by
  ext p
  rcases p with ⟨i, a⟩
  cases i
  simp [ofActivity]

omit [DecidableEq α] in
/-- The frozen-field focal payoff is the original firm's payoff after unilateral replacement,
minus the stated proximal penalty.  Here the frozen field is exactly the incumbent rivals'
appeal, so no approximation or derivative is involved. -/
theorem blockPayoff_eq_payoff_replaceFirm_sub_penalty [Fintype ι] [DecidableEq ι]
    (N : Nodes κ α) (c : ι → α → ℝ) (H : ι → α → α → ℝ) (x : Profile ι α)
    (i : ι) (kappa : ℝ) (z0 : Block α) (q : α → ℝ) :
    blockPayoff N (N.rival x i) (c i) (H i) kappa z0 (ofActivity q)
      = payoff N c H i (replaceFirm x i q)
        - (kappa / 2) * ∑ a, (q a - z0 ((), a)) ^ 2 := by
  have hact : activity (ofActivity q) = q := funext fun a ↦ activity_ofActivity q a
  have hden : ∀ l, N.denom (replaceFirm x i q) l
      = N.rival x i l + N.blockAppeal q l := by
    intro l
    rw [N.denom_eq_rival_add (replaceFirm x i q) i, N.rival_replaceFirm,
      N.appeal_replaceFirm_self]
  rw [blockPayoff, payoff]
  rw [hact]
  simp only [N.appeal_replaceFirm_self, replaceFirm_self]
  simp_rw [hden]
  simp [ofActivity]

/-- Closed-form negative gradient of `blockPayoff` when the cost matrix `H` is symmetric.  It is
represented by the existing rational-share pseudo-gradient after completing the proximal square;
`isExactResponse_iff_solvesVI` records the symmetry assumption at the optimisation boundary. -/
noncomputable def blockGradient (N : Nodes κ α) (B : κ → ℝ) (hB : ∀ l, 0 < B l)
    (c : α → ℝ) (H : α → α → ℝ) (kappa : ℝ) (z0 q : Block α) : Block α :=
  pseudoGradient (frozenNodes N B hB) (effectiveCost c kappa z0)
    (effectiveCurvature H kappa) q

/-- Coordinate formula for the response field, the negative gradient when `H` is symmetric. -/
@[simp] theorem blockGradient_apply (N : Nodes κ α) (B : κ → ℝ) (hB : ∀ l, 0 < B l)
    (c : α → ℝ) (H : α → α → ℝ) (kappa : ℝ) (z0 q : Block α) (a : α) :
    blockGradient N B hB c H kappa z0 q ((), a)
      = (c a + ∑ b, H a b * q ((), b) + kappa * (q ((), a) - z0 ((), a)))
        - ∑ l, N.revenue l * B l /
            (B l + N.blockAppeal (activity q) l) ^ 2 * N.kernel l a := by
  rw [blockGradient, pseudoGradient_apply]
  simp only [frozenNodes_revenue, frozenNodes_kernel, frozenNodes_rival, frozenNodes_denom,
    effectiveCost, effectiveCurvature]
  have hcurv : (∑ b, (H a b + kappa * if a = b then 1 else 0) * q ((), b))
      = (∑ b, H a b * q ((), b)) + kappa * q ((), a) := by
    rw [show (∑ b, (H a b + kappa * if a = b then 1 else 0) * q ((), b))
        = ∑ b, (H a b * q ((), b) +
            (kappa * if a = b then 1 else 0) * q ((), b)) from
      Finset.sum_congr rfl fun b _ ↦ by ring,
      Finset.sum_add_distrib]
    congr 1
    classical
    simp
  rw [hcurv]
  ring

/-- An exact response is a feasible block that globally maximises the stated focal payoff.
Economic uses supply `0 < B l`; the algebraic maximisation predicate itself does not need that
positivity proof as stored data. -/
def IsExactResponse (N : Nodes κ α) (B : κ → ℝ) (c : α → ℝ)
    (H : α → α → ℝ) (kappa : ℝ) (z0 q : Block α) : Prop :=
  q ∈ orthant ∧ ∀ y ∈ orthant, blockPayoff N B c H kappa z0 y ≤ blockPayoff N B c H kappa z0 q

/-- Exact focal maximisation is the one-firm orthant Nash condition for the completed-square
game.  The constant dropped by completing the square cancels from every payoff comparison. -/
theorem isExactResponse_iff_isNashOrthant (N : Nodes κ α) (B : κ → ℝ)
    (hB : ∀ l, 0 < B l) (c : α → ℝ) (H : α → α → ℝ) (kappa : ℝ)
    (z0 q : Block α) :
    IsExactResponse N B c H kappa z0 q ↔
      IsNashOrthant (frozenNodes N B hB) (effectiveCost c kappa z0)
        (effectiveCurvature H kappa) q := by
  constructor
  · intro h
    refine ⟨h.1, fun i r hr ↦ ?_⟩
    cases i
    have hmax := h.2 (ofActivity r) (fun p ↦ by
      rcases p with ⟨j, a⟩
      cases j
      simpa [ofActivity] using hr a)
    rw [blockPayoff_eq_payoff_sub_centerConst N B hB c H kappa z0 (ofActivity r),
      blockPayoff_eq_payoff_sub_centerConst N B hB c H kappa z0 q] at hmax
    simpa only [replaceFirm_singleton] using (show
      payoff (frozenNodes N B hB) (effectiveCost c kappa z0)
          (effectiveCurvature H kappa) () (ofActivity r)
        ≤ payoff (frozenNodes N B hB) (effectiveCost c kappa z0)
          (effectiveCurvature H kappa) () q by linarith)
  · intro h
    refine ⟨h.1, fun y hy ↦ ?_⟩
    have hnash := h.2 () (activity y) fun a ↦ hy ((), a)
    rw [replaceFirm_singleton, ofActivity_activity] at hnash
    rw [blockPayoff_eq_payoff_sub_centerConst N B hB c H kappa z0 y,
      blockPayoff_eq_payoff_sub_centerConst N B hB c H kappa z0 q]
    linarith

/-- **Exact maximisation is exactly the block variational inequality.**

The proof restricts each requested orthant deviation to the finite box spanned by the candidate
and that deviation, where `RationalShare.isNash_iff_solvesVI` applies.  Thus the result does not
need a capacity cap, nor does it assume that the signed effective affine cost is nonnegative. -/
theorem isExactResponse_iff_solvesVI (N : Nodes κ α) (B : κ → ℝ)
    (hB : ∀ l, 0 < B l) (c : α → ℝ) {H : α → α → ℝ} {kappa : ℝ}
    (z0 q : Block α) (hsymm : ∀ a b, H a b = H b a)
    (hpsd : ∀ u : α → ℝ, 0 ≤ ∑ a, ∑ b, H a b * u a * u b)
    (hkappa : 0 ≤ kappa) :
    IsExactResponse N B c H kappa z0 q ↔
      SolvesVI (blockGradient N B hB c H kappa z0) orthant q := by
  let NF := frozenNodes N B hB
  let ce := effectiveCost c kappa z0
  let He := effectiveCurvature H kappa
  have hHeSymm : ∀ i a b, He i a b = He i b a :=
    fun i a b ↦ effectiveCurvature_symm hsymm kappa i a b
  have hHePsd : ∀ i, ∀ u : α → ℝ,
      0 ≤ ∑ a, ∑ b, He i a b * u a * u b := by
    intro i u
    rw [show He = effectiveCurvature H kappa from rfl, effectiveCurvature_quadratic]
    exact add_nonneg (hpsd u)
      (mul_nonneg hkappa (Finset.sum_nonneg fun a _ ↦ sq_nonneg (u a)))
  have hgrad : pseudoGradient NF ce He = blockGradient N B hB c H kappa z0 := rfl
  rw [isExactResponse_iff_isNashOrthant N B hB c H kappa z0 q]
  constructor
  · intro hnash
    refine ⟨hnash.1, fun y hy ↦ ?_⟩
    let hi : Unit × α → ℝ := fun p ↦ max (q p) (y p)
    have hqbox : q ∈ box (fun _ ↦ 0) hi := fun p ↦
      ⟨hnash.1 p, le_max_left (q p) (y p)⟩
    have hybox : y ∈ box (fun _ ↦ 0) hi := fun p ↦
      ⟨hy p, le_max_right (q p) (y p)⟩
    have hnashBox : IsNash NF ce He (fun _ ↦ 0) hi q :=
      ⟨hqbox, fun i r hr ↦ hnash.2 i r fun a ↦ (hr a).1⟩
    have hvi := solvesVI_of_isNash NF ce hHeSymm hHePsd (fun _ ↦ le_refl 0) hnashBox
    rw [hgrad] at hvi
    exact hvi.2 y hybox
  · intro hvi
    have hnash : IsNashOrthant NF ce He q := by
      refine ⟨hvi.1, fun i r hr ↦ ?_⟩
      cases i
      let y : Block α := ofActivity r
      have hy : y ∈ orthant := fun p ↦ by
        rcases p with ⟨j, a⟩
        cases j
        simpa [y, ofActivity] using hr a
      let hi : Unit × α → ℝ := fun p ↦ max (q p) (y p)
      have hqbox : q ∈ box (fun _ ↦ 0) hi := fun p ↦
        ⟨hvi.1 p, le_max_left (q p) (y p)⟩
      have hviBox : SolvesVI (pseudoGradient NF ce He) (box (fun _ ↦ 0) hi) q := by
        refine ⟨hqbox, fun z hz ↦ ?_⟩
        rw [hgrad]
        exact hvi.2 z fun p ↦ (hz p).1
      have hnashBox := isNash_of_solvesVI NF ce hHeSymm hHePsd
        (fun _ ↦ le_refl 0) hviBox
      exact hnashBox.2 () r fun a ↦
        ⟨hr a, by simp [hi, y, ofActivity]⟩
    exact hnash

/-- A global Lipschitz constant for the frozen-field block gradient. -/
noncomputable def blockLipConst (N : Nodes κ α) (B : κ → ℝ) (hB : ∀ l, 0 < B l)
    (H : α → α → ℝ) (kappa : ℝ) : ℝ :=
  lipConst (ι := Unit) (frozenNodes N B hB) (effectiveCurvature H kappa)

/-- **Strong monotonicity of the frozen-field block gradient.**
The rational-share revenue field is monotone on every nonnegative box.  Any two orthant points
lie in their coordinatewise-maximum box, so the boxed result gives global orthant monotonicity;
the proximal diagonal adds `kappa` to the own-cost modulus exactly. -/
theorem stronglyMonotoneOn_blockGradient (N : Nodes κ α) (B : κ → ℝ)
    (hB : ∀ l, 0 < B l) (c : α → ℝ) {H : α → α → ℝ} {mu kappa : ℝ}
    (z0 : Block α)
    (hH : ∀ u : α → ℝ,
      mu * ∑ a, u a ^ 2 ≤ ∑ a, ∑ b, H a b * u a * u b) :
    StronglyMonotoneOn (blockGradient N B hB c H kappa z0) orthant (mu + kappa) := by
  intro x hx y hy
  let hi : Unit × α → ℝ := fun p ↦ max (x p) (y p)
  have hxbox : x ∈ box (fun _ ↦ 0) hi := fun p ↦
    ⟨hx p, le_max_left (x p) (y p)⟩
  have hybox : y ∈ box (fun _ ↦ 0) hi := fun p ↦
    ⟨hy p, le_max_right (x p) (y p)⟩
  have hmono := stronglyMonotoneOn_pseudoGradient
    (frozenNodes N B hB) (effectiveCost c kappa z0)
    (lo := fun _ ↦ 0) (hi := hi) (mu := mu + kappa) (fun _ ↦ le_refl 0)
    (fun i u ↦ effectiveCurvature_bound hH i u)
  exact hmono x hxbox y hybox

/-- **The frozen-field block gradient is globally Lipschitz on the orthant.**
As with monotonicity, each queried pair is placed in its coordinatewise-maximum box.  The bound
is independent of that cap, so it is a genuine global orthant estimate. -/
theorem lipschitzOn_blockGradient (N : Nodes κ α) (B : κ → ℝ)
    (hB : ∀ l, 0 < B l) (c : α → ℝ) (H : α → α → ℝ) (kappa : ℝ)
    (z0 : Block α) :
    ∀ x ∈ orthant, ∀ y ∈ orthant,
      ‖blockGradient N B hB c H kappa z0 x - blockGradient N B hB c H kappa z0 y‖
        ≤ blockLipConst N B hB H kappa * ‖x - y‖ := by
  intro x hx y hy
  let hi : Unit × α → ℝ := fun p ↦ max (x p) (y p)
  have hxbox : x ∈ box (fun _ ↦ 0) hi := fun p ↦
    ⟨hx p, le_max_left (x p) (y p)⟩
  have hybox : y ∈ box (fun _ ↦ 0) hi := fun p ↦
    ⟨hy p, le_max_right (x p) (y p)⟩
  exact lipschitzOn_pseudoGradient (frozenNodes N B hB) (effectiveCost c kappa z0)
    (effectiveCurvature H kappa) (lo := fun _ ↦ 0) (hi := hi) (fun _ ↦ le_refl 0)
    x hxbox y hybox

/-- The frozen-field block variational inequality has a unique solution whenever own curvature
is strictly positive and the proximal weight is nonnegative. -/
theorem existsUnique_solvesVI_blockGradient (N : Nodes κ α) (B : κ → ℝ)
    (hB : ∀ l, 0 < B l) (c : α → ℝ) {H : α → α → ℝ} {mu kappa : ℝ}
    (z0 : Block α) (hmu : 0 < mu)
    (hH : ∀ u : α → ℝ,
      mu * ∑ a, u a ^ 2 ≤ ∑ a, ∑ b, H a b * u a * u b)
    (hkappa : 0 ≤ kappa) :
    ∃! q, SolvesVI (blockGradient N B hB c H kappa z0) orthant q := by
  let M := mu + kappa
  let L := blockLipConst N B hB H kappa
  let gamma := M / (2 * (1 + M ^ 2 + L ^ 2))
  have hM : 0 < M := by dsimp [M]; linarith
  have hL : 0 ≤ L := by
    dsimp [L, blockLipConst, lipConst]
    exact add_nonneg (Real.sqrt_nonneg _) (Real.sqrt_nonneg _)
  have hden : 0 < 2 * (1 + M ^ 2 + L ^ 2) := by positivity
  have hgamma : 0 < gamma := div_pos hM hden
  have h2gm : 2 * gamma * M < 1 := by
    have hrw : 2 * gamma * M = M ^ 2 / (1 + M ^ 2 + L ^ 2) := by
      rw [show gamma = M / (2 * (1 + M ^ 2 + L ^ 2)) from rfl]
      field_simp
    rw [hrw, div_lt_one (by positivity)]
    nlinarith [sq_nonneg L]
  have hstep : gamma * L ^ 2 < 2 * M := by
    rw [show gamma = M / (2 * (1 + M ^ 2 + L ^ 2)) from rfl,
      div_mul_eq_mul_div, div_lt_iff₀ hden]
    nlinarith [sq_nonneg L, hM, sq_nonneg M]
  have hq : 1 - 2 * gamma * M + gamma ^ 2 * L ^ 2 < 1 := by
    have hlt : gamma ^ 2 * L ^ 2 < 2 * gamma * M := by
      have hfac : gamma ^ 2 * L ^ 2 = gamma * (gamma * L ^ 2) := by ring
      rw [hfac]
      calc
        gamma * (gamma * L ^ 2) < gamma * (2 * M) :=
          mul_lt_mul_of_pos_left hstep hgamma
        _ = 2 * gamma * M := by ring
    linarith
  have hq0 : 0 ≤ 1 - 2 * gamma * M + gamma ^ 2 * L ^ 2 := by
    nlinarith [h2gm, sq_nonneg (gamma * L)]
  have hmono : StronglyMonotoneOn (blockGradient N B hB c H kappa z0) orthant M := by
    simpa [M] using stronglyMonotoneOn_blockGradient N B hB c (kappa := kappa) z0 hH
  have hlip : ∀ x ∈ orthant, ∀ y ∈ orthant,
      ‖blockGradient N B hB c H kappa z0 x - blockGradient N B hB c H kappa z0 y‖
        ≤ L * ‖x - y‖ := by
    simpa [L] using lipschitzOn_blockGradient N B hB c H kappa z0
  exact existsUnique_solvesVI (F := blockGradient N B hB c H kappa z0) (s := orthant)
    orthant_nonempty isComplete_orthant convex_orthant hM hmono hlip hgamma hq hq0

/-- **Existence and uniqueness of the exact frozen-field response.**

The response is a genuine global payoff maximiser on the uncapped nonnegative orthant.  No sign
condition is needed on the completed-square affine coefficient `c - kappa * z0`; existence is
obtained from the equivalent strongly monotone variational inequality instead. -/
theorem existsUnique_isExactResponse (N : Nodes κ α) (B : κ → ℝ)
    (hB : ∀ l, 0 < B l) (c : α → ℝ) {H : α → α → ℝ} {mu kappa : ℝ}
    (z0 : Block α) (hsymm : ∀ a b, H a b = H b a) (hmu : 0 < mu)
    (hH : ∀ u : α → ℝ,
      mu * ∑ a, u a ^ 2 ≤ ∑ a, ∑ b, H a b * u a * u b)
    (hkappa : 0 ≤ kappa) :
    ∃! q, IsExactResponse N B c H kappa z0 q := by
  have hpsd : ∀ u : α → ℝ, 0 ≤ ∑ a, ∑ b, H a b * u a * u b := by
    intro u
    exact (mul_nonneg hmu.le (Finset.sum_nonneg fun a _ ↦ sq_nonneg (u a))).trans (hH u)
  obtain ⟨q, hq, huniq⟩ :=
    existsUnique_solvesVI_blockGradient N B hB c z0 hmu hH hkappa
  refine ⟨q, (isExactResponse_iff_solvesVI N B hB c z0 q hsymm hpsd hkappa).2 hq,
    fun y hy ↦ ?_⟩
  apply huniq y
  exact (isExactResponse_iff_solvesVI N B hB c z0 y hsymm hpsd hkappa).mp hy

end PricingPerspective.Operating.RationalShare.FirmResponse.Response

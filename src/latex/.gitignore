# Publish exactly the four arXiv PDFs and source archives. Intermediate logs,
# temporary builds and nested source staging remain local.
/projects/*/build/**
!/projects/*/build/
!/projects/*/build/arxiv/
!/projects/*/build/arxiv/arxiv.pdf
!/projects/*/build/arxiv/arxiv.tar.gz

# The shared semantic style is materialized by _prepare.
/projects/*/src/pp-manuscript.sty
/vendor/

# These .log files are authored test inputs.
!/tools/tests/clean.log
!/tools/tests/missing-glyph.log
